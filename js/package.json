{
  "name": "monocr",
  "version": "0.3.0",
  "description": "Cross-platform Mon (mnw) language OCR using ONNX Runtime. Supports Node.js.",
  "main": "src/index.js",
  "bin": {
    "monocr": "bin/monocr.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "download": "node bin/monocr.js download"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonDevHub/monocr-onnx.git",
    "directory": "js"
  },
  "keywords": [
    "ocr",
    "mon",
    "mnw",
    "onnx",
    "machine-learning"
  ],
  "author": "Janakh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MonDevHub/monocr-onnx/issues"
  },
  "homepage": "https://github.com/MonDevHub/monocr-onnx/tree/main/js#readme",
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^14.0.3",
    "onnxruntime-node": "^1.24.1",
    "sharp": "^0.35.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "onnxruntime-node"
    ]
  }
}
